<?xml version="1.0"?>
<!--
  Microampere: NTNU's customized BlueBoat (catamaran).
  2 fixed thrusters at the stern (one under each hull) + 1 azimuth thruster at the bow on the centerline.

  Visual: the Microampere CAD (cad/BLUEBOAT_HULL_SET_BR-101652/micro_ampere (2).stl, decimated from 754k to
  107k triangles for RViz: meshes/microampere/microampere.stl). The STL has x forward (keel rising at +x),
  z up and z = 0 at the deck, keel at z = -0.376; it is lifted by hull_height - draft = 0.102 m so the
  waterline is at the CO. The bow azimuth is not in the CAD and is drawn separately.
  Visual geometry is drawn in base_link (x forward, y left, z up, origin at CO on the waterline).
  Thruster/sensor frames are in base_link_ned (x forward, y starboard, z down), like the other vessels,
  and must match the positions in cybership_config/config/microampere/vessel.yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="microampere">

    <xacro:property name="hull_length" value="1.2" />
    <xacro:property name="hull_width" value="0.2" />
    <xacro:property name="hull_height" value="0.376" />  <!-- hull CAD -->
    <xacro:property name="hull_offset" value="0.374" />   <!-- hull centerline distance from boat centerline -->
    <xacro:property name="draft" value="0.274" />       <!-- hull depth below waterline at 30.2 kg (hull CAD) -->
    <xacro:property name="azimuth_depth" value="0.248" />  <!-- azimuth below waterline (Microampere team) -->
    <xacro:property name="stern_thruster_depth" value="0.177" />  <!-- drawing BR-101447, must match vessel.yaml -->
    <xacro:property name="stern_thruster_y" value="0.29" />       <!-- Microampere team sketch, must match vessel.yaml -->
    <xacro:property name="azimuth_x" value="0.37" />              <!-- Microampere team sketch, must match vessel.yaml -->

    <material name="hull_blue"><color rgba="0.20 0.40 0.80 1.0" /></material>
    <material name="deck_grey"><color rgba="0.55 0.58 0.60 1.0" /></material>
    <material name="thruster_yellow"><color rgba="0.95 0.80 0.10 1.0" /></material>
    <material name="dark"><color rgba="0.15 0.15 0.15 1.0" /></material>

    <material name="hull_white"><color rgba="0.88 0.89 0.90 1.0" /></material>

    <link name="base_link">
        <visual name="microampere_cad">
            <origin xyz="0 0 ${hull_height - draft}" rpy="0 0 0" />
            <geometry><mesh filename="package://cybership_description/meshes/microampere/microampere.stl" /></geometry>
            <material name="hull_white" />
        </visual>

        <!-- Bow azimuth: vertical shaft + thruster pod -->
        <visual name="azimuth_shaft">
            <origin xyz="${azimuth_x} 0 ${(hull_height - draft - azimuth_depth) / 2}" rpy="0 0 0" />
            <geometry><cylinder radius="0.015" length="${hull_height - draft + azimuth_depth}" /></geometry>
            <material name="dark" />
        </visual>
        <visual name="azimuth_pod">
            <origin xyz="${azimuth_x} 0 ${-azimuth_depth}" rpy="0 1.5708 0" />
            <geometry><cylinder radius="0.045" length="0.12" /></geometry>
            <material name="thruster_yellow" />
        </visual>

        <!-- Stern thrusters, one under each hull -->
        <visual name="stern_port_thruster">
            <origin xyz="-0.55 ${stern_thruster_y} ${-stern_thruster_depth}" rpy="0 1.5708 0" />
            <geometry><cylinder radius="0.045" length="0.12" /></geometry>
            <material name="thruster_yellow" />
        </visual>
        <visual name="stern_starboard_thruster">
            <origin xyz="-0.55 ${-stern_thruster_y} ${-stern_thruster_depth}" rpy="0 1.5708 0" />
            <geometry><cylinder radius="0.045" length="0.12" /></geometry>
            <material name="thruster_yellow" />
        </visual>

    </link>

    <link name="base_link_ned"/>
    <joint name="base_link_to_ned" type="fixed">
        <child link="base_link"/>
        <parent link="base_link_ned"/>
        <origin xyz="0 0 0" rpy="-3.1415926 0 0.0"/>
    </joint>

    <!-- Sensor frames (NED) -->
    <link name="imu_link"/>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link_ned"/>
        <child link="imu_link"/>
        <origin xyz="-0.05 0 ${-(hull_height - draft + 0.10)}" rpy="0 0 0"/>
    </joint>

    <link name="gnss_link"/>
    <joint name="gnss_joint" type="fixed">
        <parent link="base_link_ned"/>
        <child link="gnss_link"/>
        <origin xyz="-0.2 0 ${-(hull_height - draft + 0.43)}" rpy="0 0 0"/>
    </joint>

    <!-- Thruster frames (NED). Positions must match vessel.yaml. -->
    <xacro:macro name="thruster" params="thruster_name origin_xyz origin_rpy">
        <link name="${thruster_name}_link" />
        <joint name="${thruster_name}_joint" type="fixed">
            <parent link="base_link_ned" />
            <child link="${thruster_name}_link" />
            <origin xyz="${origin_xyz}" rpy="${origin_rpy}" />
        </joint>
    </xacro:macro>

    <xacro:thruster thruster_name="stern_port_thruster"      origin_xyz="-0.55 ${-stern_thruster_y} ${stern_thruster_depth}" origin_rpy="0 0 0" />
    <xacro:thruster thruster_name="stern_starboard_thruster" origin_xyz="-0.55 ${stern_thruster_y} ${stern_thruster_depth}" origin_rpy="0 0 0" />
    <xacro:thruster thruster_name="bow_azimuth_thruster"     origin_xyz="${azimuth_x} 0 ${azimuth_depth}" origin_rpy="0 0 0" />

</robot>
